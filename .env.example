# Copy to .env.local and fill in. .env.local is gitignored.

# MongoDB Atlas. Prefer the mongodb+srv form:
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shrinkless?retryWrites=true&w=majority"

# If SRV lookups fail locally (Node resolver pointing at 127.0.0.1 returns
# ECONNREFUSED), use the standard form instead. Get the shard hosts and
# replicaSet name from the cluster's SRV and TXT DNS records:
#   Resolve-DnsName _mongodb._tcp.<cluster>.mongodb.net -Type SRV
#   Resolve-DnsName <cluster>.mongodb.net -Type TXT
# MONGODB_URI="mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/shrinkless?ssl=true&replicaSet=<rs>&authSource=admin&retryWrites=true&w=majority"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Cloudinary, for product and site photography. The browser uploads straight
# to Cloudinary against a signature this app mints, so the bytes never pass
# through a serverless function with a timeout on it.
# The public cloud name is all that is needed to *read* existing images; the
# key and secret are what let the admin panel upload new ones.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Instagram, for the strip above the footer. Optional: without it the strip
# renders as a plain "follow us" band instead of the account's posts.
# Long-lived Instagram Graph token, `instagram_business_basic` scope.
# See docs/instagram.md.
INSTAGRAM_ACCESS_TOKEN=""

# Mail. Provisioned by the Vercel Resend integration:
#   vercel integration add resend/resend-email
# Without it, an admin cannot sign in — the six-digit second factor is emailed.
RESEND_API_KEY=""
# Sender. Resend's shared address works with no domain set up; swap it for
# your own once a domain is verified with Resend.
EMAIL_FROM="Shrinkless <onboarding@resend.dev>"

# Where the admin sign-in code is sent. Leave unset to use the admin
# account's own email address.
ADMIN_2FA_EMAIL=""

# The public origin, used for links that travel in email (password resets).
# On Vercel this is inferred from the deployment, so it is only needed for a
# custom domain or when developing on a port other than 3000.
NEXT_PUBLIC_SITE_URL=""

# Stripe, for checkout. Provisioned by the Vercel Stripe integration:
#   vercel integration add stripe
# Without these the checkout page says payments are unavailable rather than
# failing at the moment someone tries to pay.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen` locally, or the endpoint's signing secret in the Stripe
# dashboard. The webhook is the only thing allowed to mark an order paid, so
# without this no order ever leaves `pending`.
STRIPE_WEBHOOK_SECRET=""
